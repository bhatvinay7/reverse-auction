# Auction deployment secret/variable inventory
# ================================================================
# TEMPLATE ONLY. Do not put real credentials in Git.
#
# Create the same unprefixed names in both GitHub environments:
#   - dev: development-only values and kubeconfig
#   - prod: production-only values and kubeconfig
#
# GitHub UI:
#   auction repository -> Settings -> Environments -> dev/prod
#
# Entries marked SECRET belong under Environment secrets.
# Entries marked VARIABLE belong under Environment variables.
# GITHUB_TOKEN is supplied automatically by GitHub Actions and must not be set.

# ----------------------------------------------------------------
# GitOps repository access (SECRET unless noted)
# ----------------------------------------------------------------
GITOPS_REPO=bhatvinay7/auction-k8s
GITOPS_TOKEN=
GHCR_PULL_TOKEN=
KUBE_CONFIG=your_base64_encoded_kubeconfig

# ----------------------------------------------------------------
# Primary application data services (SECRET)
# ----------------------------------------------------------------
DATABASE_URL=postgres://auction_user:auction_pass@postgres-primary.infra.svc.cluster.local:5432/auction
REPLICATION_URL=postgres://auction_user:auction_pass@postgres-primary.infra.svc.cluster.local:5432/auction?replication=database
CDC_SLOT_NAME=auction_cdc_slot
CDC_PUBLICATION=auction_cdc_pub
REDIS_URL=redis://redis-master.infra.svc.cluster.local:6379
ELASTICSEARCH_URL=http://elasticsearch.infra.svc.cluster.local:9200

# ----------------------------------------------------------------
# Internal service endpoints (SECRET or environment-specific VARIABLE)
# ----------------------------------------------------------------
# Gateway Configuration
GATEWAY_KEEPER_ADDR=0.0.0.0:8080
SEARCH_SERVER_ADDR=http://search-server.auction.svc.cluster.local:8081
SEARCH_SERVER_BIND_ADDR=0.0.0.0:8081

# Elasticsearch & Search
# Set a restricted OpenAI project key in the GitHub Environment secret named OPENAI_API_KEY.
OPENAI_API_KEY=replace_with_openai_project_api_key
# Services
GRPC_URL=http://grpc.auction.svc.cluster.local:50051
GATEWAY_KEEPER_GRPC_URL=http://gateway-keeper.auction.svc.cluster.local:50051
HTTP_SERVER_URL=http://http-server.auction.svc.cluster.local:8082
SEARCH_SERVER_GRPC_URL=http://search-server.auction.svc.cluster.local:8081

# ----------------------------------------------------------------
# Authentication, encryption, and payments (SECRET)
# ----------------------------------------------------------------
JWT_SECRET=your_jwt_secret_here
INTERNAL_SIGNING_KEY=your_internal_signing_key_here
INVITATION_ENCRYPTION_KEY=your_invitation_encryption_key_here
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=your_razorpay_key_id

# ----------------------------------------------------------------
# Email and notification delivery (SECRET unless naturally public)
# ----------------------------------------------------------------
SMTP_HOST=smtp.yourdomain.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_pass
SMTP_FROM=noreply@yourdomain.com
GMAIL_USER=your_gmail_user@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password
SUPPORT_EMAIL=support@yourdomain.com

# ----------------------------------------------------------------
# Cloudinary media storage (SECRET)
# ----------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name

# ----------------------------------------------------------------
# Frontend build/runtime configuration
# ----------------------------------------------------------------
NEXT_PUBLIC_API_URL=https://api.yourdomain.com
NEXT_PUBLIC_SOCKET_URL=https://ws.yourdomain.com
NEXT_PUBLIC_WS_URL=wss://ws.yourdomain.com/ws
NEXT_PUBLIC_WS_BASE_URL=wss://ws.yourdomain.com
NEXT_PUBLIC_SEARCH_API_URL=https://api.yourdomain.com/search
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key
CLIENT_URL=https://auction.yourdomain.com

# ----------------------------------------------------------------
# Observability and application runtime variables
# ----------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector.monitoring.svc.cluster.local:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_METRIC_EXPORT_INTERVAL=15000
LOG_LEVEL=info
APP_MODE=production
NODE_ENV=production
AUCTION_ENVIRONMENT=production
LOCK_WORKER_CONCURRENCY=1

# ----------------------------------------------------------------
# Kafka Config
# ----------------------------------------------------------------
KAFKA_BROKERS=auction-kafka-kafka-bootstrap.kafka.svc.cluster.local:9093
KAFKA_SECURITY_PROTOCOL=SSL
KAFKA_REPLICATION_FACTOR=1
KAFKA_BID_PARTITIONS=3
KAFKA_BACKGROUND_PARTITIONS=3
# Kafka TLS is generated on first bootstrap and reused from kafka/kafka-broker-tls.
# Bootstrap does not read Kafka TLS material from this tracked template.
KAFKA_TLS_BOOTSTRAP_MANAGED=true

# ----------------------------------------------------------------
# Runtime capacities & limits
# ----------------------------------------------------------------
AUCTION_ACTOR_QUEUE_CAPACITY=10000
AUCTION_KAFKA_PARTITION_QUEUE_CAPACITY=10000
DOWNSTREAM_TIMEOUT_SECS=30
CIRCUIT_FAILURE_THRESHOLD=5
CIRCUIT_OPEN_SECS=10

# ----------------------------------------------------------------
# Grafana and ExternalDNS
# ----------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin_password

# ----------------------------------------------------------------
# CI test-only secrets
# ----------------------------------------------------------------
TEST_REDIS_URL=redis://127.0.0.1:6379
TEST_DATABASE_URL=postgres://test_user:test_pass@127.0.0.1:5432/test_auction

# ----------------------------------------------------------------
# Added by Agent: Required by seal-secrets.py for kubernetes manifests
# ----------------------------------------------------------------
ARGOCD_HOST=argocd.yourdomain.com
GHCR_TOKEN=your_ghcr_token
GHCR_USERNAME=your_ghcr_username
GRAFANA_HOST=grafana.yourdomain.com
GRPC_URL=http://grpc:50051
HTTP_PORT=8083
HTTP_SERVER_ADDR=0.0.0.0:8082
PORT=50051
REDIS_EXPORTER_ADDR=redis://127.0.0.1:6379
RUST_LOG=info
WEB_HOSTNAME=0.0.0.0
WEB_PORT=3000
WS_SERVER_ADDR=0.0.0.0:8081
WS_SERVER_URL=http://ws-server:8081

# Additional missing keys added automatically
CORS_ALLOWED_ORIGIN=placeholder
FRONTEND_URL=placeholder
