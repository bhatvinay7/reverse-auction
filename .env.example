# Docker Compose
COMPOSE_PARALLEL_LIMIT=1

# PostgreSQL and Redis
DATABASE_URL=postgresql://auction:change-me@localhost:5432/auction
CDC_SLOT_NAME=auction_cdc_slot
CDC_PUBLICATION=auction_cdc_pub
REDIS_URL=redis://localhost:6379

# Kafka
KAFKA_BROKERS=localhost:9092
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_SASL_MECHANISM=PLAIN
KAFKA_USERNAME=change-me
KAFKA_PASSWORD=change-me
# Base64 of the Kafka CA certificate; decoded in memory by auction-kafka.
KAFKA_SSL_CA_BASE64=replace-with-base64-encoded-ca-certificate
KAFKA_BID_PARTITIONS=16
KAFKA_BACKGROUND_PARTITIONS=4
KAFKA_REPLICATION_FACTOR=1
KAFKA_CLIENT_ID=auction-local

# Authentication and internal service identity (use independent values >= 32 bytes)
JWT_SECRET=replace-with-a-random-value-at-least-32-bytes
JWT_ISSUER=
JWT_AUDIENCE=
INTERNAL_SIGNING_KEY=replace-with-another-random-value-at-least-32-bytes

# Service endpoints and ports
HTTP_PORT=8080
PORT=50051# Gateway Configuration
GATEWAY_KEEPER_ADDR=0.0.0.0:8080
SEARCH_SERVER_ADDR=http://127.0.0.1:8081

# Elasticsearch & Search
ELASTICSEARCH_URL=http://localhost:9200
OPENAI_API_KEY=your_openai_api_key_here
GRPC_URL=http://localhost:50051
HTTP_SERVER_URL=http://localhost:8080
WS_SERVER_URL=http://localhost:8081
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGIN=http://localhost:3000

# Gateway resilience
DOWNSTREAM_TIMEOUT_SECS=20
CIRCUIT_FAILURE_THRESHOLD=5
CIRCUIT_OPEN_SECS=30

# Auction workers
AUCTION_ACTOR_QUEUE_CAPACITY=1000
AUCTION_KAFKA_PARTITION_QUEUE_CAPACITY=1000

# Email
SMTP_HOST=smtp.example.com
SMTP_USER=change-me@example.com
SMTP_PASS=change-me

# Cloudinary uploads
CLOUDINARY_CLOUD_NAME=change-me
CLOUDINARY_API_KEY=change-me
CLOUDINARY_API_SECRET=change-me

# Cloudflare R2 database backups
CLOUDFLARE_R2_ACCESS_KEY_ID=change-me
CLOUDFLARE_R2_SECRET_ACCESS_KEY=change-me
CLOUDFLARE_R2_ENDPOINT=https://change-me.r2.cloudflarestorage.com
CLOUDFLARE_R2_BUCKET=auction-backups

# Browser-visible web configuration (these values are not secrets)
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_SOCKET_URL=http://localhost:8080
NEXT_PUBLIC_WS_URL=http://localhost:8080
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=change-me

# Logging and OpenTelemetry
RUST_LOG=info
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_METRIC_EXPORT_INTERVAL=15000
AUCTION_ENVIRONMENT=local
APP_ENV=local
NODE_ENV=development

# SealedSecret image-pull credentials used by seal-cluster-secrets.sh
GHCR_USERNAME=change-me
GHCR_TOKEN=change-me

# GitHub Actions repository/environment settings. Configure these in GitHub,
# not in a deployed application's Secret.
GITOPS_TOKEN=change-me
KUBE_CONFIG=base64-encoded-kubeconfig
DEV_PUBLIC_API_URL=https://api.dev.example.com
DEV_PUBLIC_SOCKET_URL=https://ws.dev.example.com
